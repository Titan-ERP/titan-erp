[Unit]
Description=Run one protected internal Sparex catalog cycle
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/southern-parts/catalog-agent/current
EnvironmentFile=/opt/southern-parts/catalog-agent/catalog-pipeline.env
Environment=CATALOG_AGENT_INSTALL_ROOT=/opt/southern-parts/catalog-agent
Environment=ODOO_ENV_FILE=/opt/southern-parts/Odoo/odoo_connection.env
Environment=PYTHONPATH=/opt/southern-parts/catalog-agent/current
Environment=SOUTHERN_PRODUCT_ARTIFACT_BUCKET=southern-parts-catalog-artifacts-475369996980-us-east-1
ExecStart=/bin/bash /opt/southern-parts/catalog-agent/current/scripts/run_sparex_durable_discovery.sh
RuntimeDirectory=titan-sparex-catalog
RuntimeDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/southern-parts/catalog-agent/artifacts
StandardOutput=journal
StandardError=journal
TimeoutStartSec=15min
