[Unit]
Description=Titan Odoo catalog-agent verification and website release
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/southern-parts/catalog-agent/current
ExecStart=/opt/southern-parts/catalog-agent/current/scripts/run_catalog_agent_automation.sh
Environment=CATALOG_AGENT_INSTALL_ROOT=/opt/southern-parts/catalog-agent
Environment=ODOO_ENV_FILE=/opt/southern-parts/Odoo/odoo_connection.env
Environment=OPENAI_KEY_PARAMETER=/southern-parts/sparex-odoo/OPENAI_API_KEY
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/southern-parts/catalog-agent/artifacts
StandardOutput=journal
StandardError=journal
TimeoutStartSec=12min

[Install]
WantedBy=multi-user.target
