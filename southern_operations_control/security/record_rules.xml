<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_southern_operations_daily_control_company" model="ir.rule">
        <field name="name">Daily operations controls allowed companies</field>
        <field name="model_id" ref="model_southern_operations_daily_control"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
    <record id="rule_southern_contact_import_batch_company" model="ir.rule">
        <field name="name">Contact import batches allowed companies</field>
        <field name="model_id" ref="model_southern_contact_import_batch"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
    <record id="rule_southern_contact_import_line_company" model="ir.rule">
        <field name="name">Contact import lines allowed companies</field>
        <field name="model_id" ref="model_southern_contact_import_line"/>
        <field name="domain_force">[('batch_id.company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
</odoo>
