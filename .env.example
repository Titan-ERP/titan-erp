# Local-only environment layout. Never place real secrets in this template.
AWS_PROFILE=cross-admin
ODOO_ENV_FILE=odoo_connection.env
OPENAI_ENV_FILE=.env.local
ODOO_WRITE_ENABLED=0

# Odoo connection values are supplied by the ignored odoo_connection.env file.
ODOO_URL=https://your-company.odoo.com
ODOO_DB=your_database_name
ODOO_API_KEY=

# Optional agent workflow credential is supplied by the ignored .env.local file.
OPENAI_API_KEY=

# Stripe values are local-only. Retrieve them from the approved Odoo Stripe
# provider; never copy live values into Git, chat, logs, or screenshots.
STRIPE_ACCOUNT_ID=
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TERMINAL_WEBHOOK_SECRET=
STRIPE_TERMINAL_READER_ID=
STRIPE_TERMINAL_LOCATION_ID=
