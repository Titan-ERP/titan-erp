<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_order_form_southern_parts_cost_check" model="ir.ui.view">
        <field name="name">sale.order.form.southern.parts.cost.check</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Southern Cost Check" name="southern_cost_check">
                    <group>
                        <group>
                            <field name="southern_cost_verification_status" readonly="1"/>
                            <field name="southern_cost_verified_at" readonly="1"/>
                            <field name="southern_estimated_parts_revenue" readonly="1"/>
                        </group>
                        <group>
                            <field name="southern_estimated_parts_cost" readonly="1"/>
                            <field name="southern_estimated_parts_margin" readonly="1"/>
                            <field name="southern_estimated_parts_margin_rate" widget="percentage" readonly="1"/>
                        </group>
                    </group>
                    <field name="southern_cost_verification_note" readonly="1" nolabel="1"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
