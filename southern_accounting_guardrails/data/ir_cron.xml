<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_southern_daily_accounting_control" model="ir.cron">
        <field name="name">Southern Daily Accounting Control Refresh</field>
        <field name="model_id" ref="model_southern_accounting_daily_control"/>
        <field name="state">code</field>
        <field name="code">model.cron_refresh_daily_controls()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">False</field>
    </record>
    <record id="ir_cron_southern_bank_coding_candidates" model="ir.cron">
        <field name="name">Southern Bank Coding Candidate Refresh</field>
        <field name="model_id" ref="model_southern_bank_coding_run"/>
        <field name="state">code</field>
        <field name="code">model.cron_prepare_candidates()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">False</field>
    </record>
</odoo>
