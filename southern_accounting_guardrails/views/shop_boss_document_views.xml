<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_southern_shop_boss_document_list" model="ir.ui.view">
        <field name="name">southern.shop.boss.document.list</field>
        <field name="model">southern.shop_boss.document</field>
        <field name="arch" type="xml">
            <list decoration-success="coverage_status in ['invoice_linked', 'summary_revenue', 'bank_matched', 'asset_sale']"
                  decoration-warning="coverage_status in ['not_reviewed', 'needs_invoice']"
                  decoration-danger="coverage_status == 'exception'">
                <field name="document_date"/>
                <field name="name"/>
                <field name="customer_name"/>
                <field name="partner_id"/>
                <field name="accounting_bucket"/>
                <field name="revenue_amount"/>
                <field name="tax_amount"/>
                <field name="total_amount"/>
                <field name="shop_boss_status"/>
                <field name="coverage_status"/>
                <field name="invoice_id"/>
                <field name="payment_batch_id"/>
            </list>
        </field>
    </record>

    <record id="view_southern_shop_boss_document_form" model="ir.ui.view">
        <field name="name">southern.shop.boss.document.form</field>
        <field name="model">southern.shop_boss.document</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_find_partner" type="object" string="Find Partner"/>
                    <button name="action_mark_needs_invoice" type="object" string="Needs Invoice"/>
                    <button name="action_mark_summary_revenue" type="object" string="Summary Covered"/>
                    <button name="action_mark_asset_sale" type="object" string="Asset Sale"/>
                    <button name="action_mark_exception" type="object" string="Exception"/>
                    <field name="coverage_status" widget="statusbar"
                           statusbar_visible="not_reviewed,needs_invoice,invoice_linked,summary_revenue,asset_sale,exception"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_view_invoice"
                                icon="fa-file-text-o" invisible="not invoice_id">
                            <div class="o_stat_info"><span class="o_stat_text">Invoice</span></div>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_view_bank_lines"
                                icon="fa-bank">
                            <div class="o_stat_info"><span class="o_stat_text">Bank Lines</span></div>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group string="Shop Boss">
                            <field name="company_id"/>
                            <field name="document_type"/>
                            <field name="document_number"/>
                            <field name="document_date"/>
                            <field name="shop_boss_status"/>
                            <field name="source_file"/>
                        </group>
                        <group string="Customer">
                            <field name="customer_name"/>
                            <field name="partner_id"/>
                            <field name="vehicle_or_equipment"/>
                        </group>
                    </group>
                    <group string="Amounts">
                        <field name="currency_id" invisible="1"/>
                        <field name="parts_amount"/>
                        <field name="service_amount"/>
                        <field name="rental_amount"/>
                        <field name="equipment_amount"/>
                        <field name="fees_amount"/>
                        <field name="discount_amount"/>
                        <field name="tax_amount"/>
                        <field name="revenue_amount" readonly="1"/>
                        <field name="total_amount" readonly="1"/>
                        <field name="accounting_bucket" readonly="1"/>
                    </group>
                    <group string="Odoo Coverage">
                        <field name="invoice_id"/>
                        <field name="payment_batch_id"/>
                    </group>
                    <notebook>
                        <page string="Bank Lines">
                            <field name="bank_statement_line_ids" readonly="1">
                                <list>
                                    <field name="date"/>
                                    <field name="journal_id"/>
                                    <field name="payment_ref"/>
                                    <field name="amount"/>
                                    <field name="is_reconciled"/>
                                    <field name="southern_review_bucket"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="review_note" placeholder="Coverage decision, source caveat, or exception reason."/>
                            <field name="source_notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_southern_shop_boss_documents" model="ir.actions.act_window">
        <field name="name">Shop Boss Documents</field>
        <field name="res_model">southern.shop_boss.document</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
