<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_southern_bank_statement_line_review_list" model="ir.ui.view">
        <field name="name">southern.bank.statement.line.review.list</field>
        <field name="model">account.bank.statement.line</field>
        <field name="arch" type="xml">
            <list decoration-success="southern_review_status == 'reviewed'"
                  decoration-warning="southern_review_status == 'needs_review'"
                  decoration-danger="southern_review_status == 'exception'">
                <button name="action_southern_mark_reviewed" type="object" string="Reviewed"/>
                <button name="action_southern_mark_exception" type="object" string="Exception"/>
                <button name="action_southern_mark_needs_review" type="object" string="Needs Review"/>
                <field name="date"/>
                <field name="journal_id"/>
                <field name="partner_id"/>
                <field name="payment_ref"/>
                <field name="amount"/>
                <field name="is_reconciled"/>
                <field name="southern_manual_review_bucket"/>
                <field name="southern_review_bucket"/>
                <field name="southern_review_status"/>
                <field name="southern_missing_partner"/>
                <field name="southern_is_merchant_settlement"/>
                <field name="southern_expected_merchant_fee"/>
                <field name="southern_shop_boss_batch_ref"/>
                <field name="southern_shop_boss_document_id"/>
                <field name="southern_shop_boss_payment_batch_id"/>
            </list>
        </field>
    </record>

    <record id="view_southern_bank_statement_line_review_search" model="ir.ui.view">
        <field name="name">southern.bank.statement.line.review.search</field>
        <field name="model">account.bank.statement.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="payment_ref"/>
                <field name="partner_id"/>
                <field name="southern_shop_boss_batch_ref"/>
                <filter name="needs_review" string="Needs Review" domain="[('southern_review_status', '=', 'needs_review')]"/>
                <filter name="exceptions" string="Exceptions" domain="[('southern_review_status', '=', 'exception')]"/>
                <filter name="reviewed" string="Reviewed" domain="[('southern_review_status', '=', 'reviewed')]"/>
                <filter name="missing_partner" string="Missing Partner" domain="[('southern_missing_partner', '=', True)]"/>
                <filter name="merchant" string="Merchant Settlements" domain="[('southern_is_merchant_settlement', '=', True)]"/>
                <filter name="generic_checks" string="Generic Checks" domain="[('southern_is_generic_check', '=', True)]"/>
                <filter name="reconciled" string="Reconciled" domain="[('is_reconciled', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_bucket" string="Bucket" context="{'group_by': 'southern_review_bucket'}"/>
                    <filter name="group_status" string="Review Status" context="{'group_by': 'southern_review_status'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_southern_bank_statement_line_review" model="ir.actions.act_window">
        <field name="name">Bank Matching Review</field>
        <field name="res_model">account.bank.statement.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_southern_bank_statement_line_review_search"/>
        <field name="context">{'search_default_needs_review': 1, 'search_default_group_bucket': 1}</field>
    </record>
</odoo>
