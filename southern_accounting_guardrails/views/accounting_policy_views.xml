<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_southern_accounting_policy_list" model="ir.ui.view">
        <field name="name">southern.accounting.policy.list</field>
        <field name="model">southern.accounting.policy</field>
        <field name="arch" type="xml">
            <list>
                <field name="company_id"/>
                <field name="active"/>
                <field name="parts_revenue_account_id"/>
                <field name="service_revenue_account_id"/>
                <field name="rental_revenue_account_id"/>
                <field name="parts_cost_account_id"/>
                <field name="service_cost_account_id"/>
                <field name="merchant_fee_account_id"/>
                <field name="payment_clearing_account_id"/>
                <field name="check_review_account_id"/>
            </list>
        </field>
    </record>

    <record id="view_southern_accounting_policy_form" model="ir.ui.view">
        <field name="name">southern.accounting.policy.form</field>
        <field name="model">southern.accounting.policy</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_fill_from_chart" type="object" string="Fill From Chart"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="company_id"/>
                            <field name="active"/>
                            <field name="auto_apply_draft_revenue_accounts"/>
                            <field name="require_product_bucket"/>
                        </group>
                        <group string="Tolerances">
                            <field name="currency_id" invisible="1"/>
                            <field name="merchant_fee_tolerance"/>
                            <field name="bank_match_tolerance"/>
                        </group>
                    </group>
                    <group string="Revenue Accounts">
                        <field name="parts_revenue_account_id"/>
                        <field name="service_revenue_account_id"/>
                        <field name="rental_revenue_account_id"/>
                        <field name="equipment_revenue_account_id"/>
                        <field name="fees_revenue_account_id"/>
                    </group>
                    <group string="Cost Accounts">
                        <field name="equipment_cost_account_id"/>
                        <field name="parts_cost_account_id"/>
                        <field name="service_cost_account_id"/>
                        <field name="rental_cost_account_id"/>
                    </group>
                    <group string="Sales and Purchase Entry Controls">
                        <field name="commercial_order_guardrail_mode"/>
                        <field name="commercial_order_guardrail_effective_at"
                               invisible="commercial_order_guardrail_mode != 'enforce'"/>
                        <field name="require_sale_tax_selection"/>
                        <field name="require_purchase_tax_selection"/>
                    </group>
                    <group string="Bank Matching Accounts">
                        <field name="merchant_fee_account_id"/>
                        <field name="payment_clearing_account_id"/>
                        <field name="check_review_account_id"/>
                    </group>
                    <field name="note" placeholder="Company-specific accounting policy decisions."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_southern_accounting_policies" model="ir.actions.act_window">
        <field name="name">Accounting Policies</field>
        <field name="res_model">southern.accounting.policy</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
