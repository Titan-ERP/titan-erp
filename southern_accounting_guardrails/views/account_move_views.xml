<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_southern_account_move_guardrail_list" model="ir.ui.view">
        <field name="name">southern.account.move.guardrail.list</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <list decoration-success="southern_review_lane == 'verified'"
                  decoration-warning="southern_review_lane in ['source_review', 'needs_review']"
                  decoration-danger="southern_review_lane == 'exception'"
                  decoration-muted="southern_review_lane == 'not_required'">
                <field name="name"/>
                <field name="invoice_date"/>
                <field name="partner_id"/>
                <field name="move_type"/>
                <field name="state"/>
                <field name="payment_state"/>
                <field name="amount_total"/>
                <field name="southern_source_system"/>
                <field name="southern_shop_boss_reference"/>
                <field name="southern_shop_boss_verified"/>
                <field name="southern_review_lane"/>
                <field name="southern_review_details"/>
                <field name="southern_review_status"/>
            </list>
        </field>
    </record>

    <record id="view_move_form_southern_accounting_guardrails" model="ir.ui.view">
        <field name="name">account.move.form.southern.accounting.guardrails</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Southern Review">
                    <group>
                        <group string="Source">
                            <field name="southern_source_system"/>
                            <field name="southern_shop_boss_document_id"/>
                            <field name="southern_shop_boss_type"/>
                            <field name="southern_shop_boss_number"/>
                            <field name="southern_shop_boss_reference" readonly="1"/>
                            <field name="southern_shop_boss_status"/>
                        </group>
                        <group string="Review">
                            <field name="southern_shop_boss_verified"/>
                            <field name="southern_review_status"/>
                            <field name="southern_review_lane" readonly="1"/>
                            <field name="southern_review_details" readonly="1"/>
                            <field name="southern_has_shop_boss_reference" readonly="1"/>
                        </group>
                    </group>
                    <field name="southern_review_note" placeholder="Document source, exception reason, or cleanup decision."/>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_southern_account_move_guardrail_search" model="ir.ui.view">
        <field name="name">southern.account.move.guardrail.search</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="southern_shop_boss_reference"/>
                <field name="southern_review_details"/>
                <filter name="work_needed" string="Work Needed"
                        domain="[('southern_review_lane', 'in', ['source_review', 'needs_review', 'exception'])]"/>
                <filter name="source_review" string="Legacy Source"
                        domain="[('southern_review_lane', '=', 'source_review')]"/>
                <filter name="generic_review" string="Generic Review"
                        domain="[('southern_review_lane', '=', 'needs_review')]"/>
                <filter name="exceptions" string="Exceptions"
                        domain="[('southern_review_lane', '=', 'exception')]"/>
                <filter name="verified" string="Verified"
                        domain="[('southern_review_lane', '=', 'verified')]"/>
                <filter name="not_required" string="Not Required"
                        domain="[('southern_review_lane', '=', 'not_required')]"/>
                <separator/>
                <filter name="group_lane" string="Work Lane" context="{'group_by': 'southern_review_lane'}"/>
            </search>
        </field>
    </record>

    <record id="action_southern_accounting_invoice_review" model="ir.actions.act_window">
        <field name="name">Invoice Source Review</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type', 'in', ['out_invoice', 'out_refund']), ('state', '!=', 'cancel'), ('southern_review_lane', 'in', ['source_review', 'needs_review', 'exception'])]</field>
        <field name="context">{'search_default_work_needed': 1}</field>
    </record>
</odoo>
