<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_southern_revenue_rule_list" model="ir.ui.view">
        <field name="name">southern.accounting.revenue.rule.list</field>
        <field name="model">southern.accounting.revenue.rule</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active"/>
                <field name="match_text"/>
                <field name="revenue_bucket"/>
                <field name="income_account_id"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <record id="view_southern_revenue_rule_form" model="ir.ui.view">
        <field name="name">southern.accounting.revenue.rule.form</field>
        <field name="model">southern.accounting.revenue.rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="active"/>
                            <field name="sequence"/>
                            <field name="company_id"/>
                        </group>
                        <group>
                            <field name="match_text"/>
                            <field name="revenue_bucket"/>
                            <field name="income_account_id"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Why this classification exists."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_southern_revenue_rule_search" model="ir.ui.view">
        <field name="name">southern.accounting.revenue.rule.search</field>
        <field name="model">southern.accounting.revenue.rule</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="match_text"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_bucket" string="Bucket" context="{'group_by': 'revenue_bucket'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_southern_revenue_rules" model="ir.actions.act_window">
        <field name="name">Revenue Rules</field>
        <field name="res_model">southern.accounting.revenue.rule</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_southern_revenue_rule_search"/>
        <field name="context">{'search_default_active': 1}</field>
    </record>
</odoo>
