<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_southern_daily_control_list" model="ir.ui.view">
        <field name="name">southern.accounting.daily.control.list</field>
        <field name="model">southern.accounting.daily.control</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'reviewed'"
                  decoration-warning="state == 'open'"
                  decoration-danger="state == 'exception'">
                <field name="control_date"/>
                <field name="company_id"/>
                <field name="state"/>
                <field name="bank_line_count"/>
                <field name="unreconciled_bank_line_count"/>
                <field name="bank_needs_review_count"/>
                <field name="bank_exception_count"/>
                <field name="merchant_batch_needs_review_count"/>
                <field name="revenue_line_needs_review_count"/>
                <field name="draft_invoice_count"/>
                <field name="unverified_migration_invoice_count"/>
                <field name="pending_coding_candidate_count"/>
                <field name="bank_blocked_count"/>
                <field name="bank_merchant_open_count"/>
                <field name="invoice_source_review_count"/>
                <field name="product_missing_bucket_count"/>
                <field name="last_refreshed_at"/>
            </list>
        </field>
    </record>

    <record id="view_southern_daily_control_form" model="ir.ui.view">
        <field name="name">southern.accounting.daily.control.form</field>
        <field name="model">southern.accounting.daily.control</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_refresh_counts" type="object" string="Refresh Counts"/>
                    <button name="action_mark_reviewed" type="object" string="Mark Reviewed"/>
                    <button name="action_mark_exception" type="object" string="Exception"/>
                    <button name="action_reopen" type="object" string="Reopen"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,reviewed,exception"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_view_bank_review" icon="fa-bank">
                            <field name="bank_line_count" widget="statinfo" string="Bank Lines"/>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_view_bank_blocked" icon="fa-ban">
                            <field name="bank_blocked_count" widget="statinfo" string="Blocked"/>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_view_bank_merchant" icon="fa-credit-card">
                            <field name="bank_merchant_open_count" widget="statinfo" string="Merchant"/>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_view_bank_coding_candidates" icon="fa-check-square-o">
                            <field name="pending_coding_candidate_count" widget="statinfo" string="Coding"/>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_view_invoice_source_review" icon="fa-file-text-o">
                            <field name="invoice_source_review_count" widget="statinfo" string="Source Review"/>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_view_revenue_review" icon="fa-list">
                            <field name="revenue_line_needs_review_count" widget="statinfo" string="Revenue Review"/>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_view_product_account_review" icon="fa-tags">
                            <field name="product_account_needs_review_count" widget="statinfo" string="Products"/>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_view_product_missing_bucket" icon="fa-folder-open-o">
                            <field name="product_missing_bucket_count" widget="statinfo" string="Buckets"/>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="control_date"/>
                            <field name="company_id"/>
                            <field name="last_refreshed_at" readonly="1"/>
                        </group>
                        <group string="Today">
                            <field name="unreconciled_bank_line_count" readonly="1"/>
                            <field name="bank_needs_review_count" readonly="1"/>
                            <field name="bank_exception_count" readonly="1"/>
                            <field name="merchant_batch_needs_review_count" readonly="1"/>
                            <field name="revenue_line_needs_review_count" readonly="1"/>
                            <field name="draft_invoice_count" readonly="1"/>
                            <field name="unverified_migration_invoice_count" readonly="1"/>
                        </group>
                        <group string="Open Work Lanes">
                            <field name="bank_blocked_count" readonly="1"/>
                            <field name="bank_merchant_open_count" readonly="1"/>
                            <field name="pending_coding_candidate_count" readonly="1"/>
                            <field name="invoice_source_review_count" readonly="1"/>
                            <field name="product_account_needs_review_count" readonly="1"/>
                            <field name="product_missing_bucket_count" readonly="1"/>
                        </group>
                    </group>
                    <field name="review_note" placeholder="Daily close notes, cleanup decisions, or exceptions."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_southern_daily_controls" model="ir.actions.act_window">
        <field name="name">Daily Controls</field>
        <field name="res_model">southern.accounting.daily.control</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
