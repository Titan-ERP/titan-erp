<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_southern_accounting_guardrails" model="ir.ui.view">
        <field name="name">product.template.form.southern.accounting.guardrails</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_standard_price']" position="after">
                <group string="Southern Accounting">
                    <field name="southern_revenue_bucket"/>
                    <field name="southern_accounting_review_lane" readonly="1"/>
                    <field name="southern_accounting_review_details" readonly="1"/>
                    <field name="southern_expected_income_account_id" readonly="1"/>
                    <field name="southern_income_account_review" readonly="1"/>
                    <field name="southern_expected_expense_account_id" readonly="1"/>
                    <field name="southern_expense_account_review" readonly="1"/>
                    <field name="southern_accounting_review_note"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_product_template_southern_accounting_list" model="ir.ui.view">
        <field name="name">product.template.southern.accounting.list</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <list decoration-warning="southern_accounting_review_lane in ['missing_bucket', 'income', 'cost']"
                  decoration-danger="southern_accounting_review_lane == 'both'">
                <field name="name"/>
                <field name="default_code"/>
                <field name="categ_id"/>
                <field name="southern_revenue_bucket"/>
                <field name="southern_accounting_review_lane"/>
                <field name="southern_accounting_review_details"/>
                <field name="property_account_income_id"/>
                <field name="southern_expected_income_account_id"/>
                <field name="southern_income_account_review"/>
                <field name="property_account_expense_id"/>
                <field name="southern_expected_expense_account_id"/>
                <field name="southern_expense_account_review"/>
                <field name="sale_ok"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_product_template_southern_accounting_search" model="ir.ui.view">
        <field name="name">product.template.southern.accounting.search</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="default_code"/>
                <field name="southern_accounting_review_details"/>
                <filter name="work_needed" string="Work Needed"
                        domain="[('southern_accounting_review_lane', '!=', 'ok')]"/>
                <filter name="missing_bucket" string="Missing Revenue Bucket"
                        domain="[('southern_accounting_review_lane', '=', 'missing_bucket')]"/>
                <filter name="income" string="Income Account"
                        domain="[('southern_accounting_review_lane', '=', 'income')]"/>
                <filter name="cost" string="Cost Account"
                        domain="[('southern_accounting_review_lane', '=', 'cost')]"/>
                <filter name="both" string="Income and Cost"
                        domain="[('southern_accounting_review_lane', '=', 'both')]"/>
                <separator/>
                <filter name="group_lane" string="Work Lane" context="{'group_by': 'southern_accounting_review_lane'}"/>
            </search>
        </field>
    </record>

    <record id="action_southern_product_accounting_review" model="ir.actions.act_window">
        <field name="name">Product Accounting Review</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('sale_ok', '=', True), ('southern_accounting_review_lane', '!=', 'ok')]</field>
        <field name="context">{'search_default_work_needed': 1}</field>
    </record>

    <record id="view_product_category_form_southern_accounting_guardrails" model="ir.ui.view">
        <field name="name">product.category.form.southern.accounting.guardrails</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='first']" position="inside">
                <group string="Southern Accounting">
                    <field name="southern_accounting_bucket"/>
                    <field name="southern_accounting_review_note"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
