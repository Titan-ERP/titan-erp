<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_southern_bank_coding_rule_company" model="ir.rule">
        <field name="name">Bank coding rules allowed companies</field>
        <field name="model_id" ref="model_southern_bank_coding_rule"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
    <record id="rule_southern_bank_coding_run_company" model="ir.rule">
        <field name="name">Bank coding runs allowed companies</field>
        <field name="model_id" ref="model_southern_bank_coding_run"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
    <record id="rule_southern_bank_coding_candidate_company" model="ir.rule">
        <field name="name">Bank coding candidates allowed companies</field>
        <field name="model_id" ref="model_southern_bank_coding_candidate"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
</odoo>
