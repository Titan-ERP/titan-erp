<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_southern_service" model="ir.module.category">
        <field name="name">Southern Service</field>
        <field name="description">Unified access to customer and internal Service work.</field>
        <field name="sequence">30</field>
    </record>

    <record id="privilege_southern_service" model="res.groups.privilege">
        <field name="name">Service Access</field>
        <field name="category_id" ref="module_category_southern_service"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_southern_service_user" model="res.groups">
        <field name="name">Service User</field>
        <field name="privilege_id" ref="privilege_southern_service"/>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[
            (4, ref('base.group_user')),
            (4, ref('cs_client_equipment.group_client_equipment_user'))
        ]"/>
    </record>

    <record id="group_southern_service_manager" model="res.groups">
        <field name="name">Service Manager</field>
        <field name="privilege_id" ref="privilege_southern_service"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[
            (4, ref('group_southern_service_user')),
            (4, ref('cs_client_equipment.group_client_equipment_administrator'))
        ]"/>
    </record>

    <record id="southern_service_case_company_rule" model="ir.rule">
        <field name="name">Service Case: User companies</field>
        <field name="model_id" ref="model_southern_service_case"/>
        <field name="domain_force">[
            '|',
                ('partner_id', '=', False),
                ('partner_id.company_id', 'in', [False] + company_ids)
        ]</field>
        <field name="groups" eval="[(4, ref('group_southern_service_user'))]"/>
    </record>
</odoo>
