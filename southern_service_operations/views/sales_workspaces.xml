<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Parts stays on the native Sales order model, with a focused workspace. -->
    <record id="action_southern_parts_all" model="ir.actions.act_window">
        <field name="name">Parts</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('southern_quote_type', '=', 'parts')]</field>
        <field name="context">{'default_southern_quote_type': 'parts'}</field>
    </record>

    <record id="action_southern_parts_quotations" model="ir.actions.act_window">
        <field name="name">Parts Quotations</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('southern_quote_type', '=', 'parts'), ('state', 'in', ['draft', 'sent'])]</field>
        <field name="context">{'default_southern_quote_type': 'parts'}</field>
    </record>

    <record id="action_southern_parts_orders" model="ir.actions.act_window">
        <field name="name">Parts Orders</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('southern_quote_type', '=', 'parts'), ('state', 'in', ['sale', 'done'])]</field>
        <field name="context">{'default_southern_quote_type': 'parts'}</field>
    </record>

    <!-- Equipment sales also remain normal quotations and sales orders. -->
    <record id="action_southern_equipment_sales_all" model="ir.actions.act_window">
        <field name="name">Equipment Sales</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('southern_quote_type', '=', 'equipment_sale')]</field>
        <field name="context">{'default_southern_quote_type': 'equipment_sale'}</field>
    </record>

    <record id="action_southern_equipment_quotations" model="ir.actions.act_window">
        <field name="name">Equipment Quotations</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('southern_quote_type', '=', 'equipment_sale'), ('state', 'in', ['draft', 'sent'])]</field>
        <field name="context">{'default_southern_quote_type': 'equipment_sale'}</field>
    </record>

    <record id="action_southern_equipment_orders" model="ir.actions.act_window">
        <field name="name">Equipment Orders</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('southern_quote_type', '=', 'equipment_sale'), ('state', 'in', ['sale', 'done'])]</field>
        <field name="context">{'default_southern_quote_type': 'equipment_sale'}</field>
    </record>

    <!-- Rental uses Odoo's native rental marker and includes legacy native rentals. -->
    <record id="action_southern_rentals_all" model="ir.actions.act_window">
        <field name="name">Rentals</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('is_rental_order', '=', True)]</field>
        <field name="context">{'default_southern_quote_type': 'rental', 'default_is_rental_order': True}</field>
    </record>

    <record id="action_southern_rental_quotations" model="ir.actions.act_window">
        <field name="name">Rental Quotations</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('is_rental_order', '=', True), ('state', 'in', ['draft', 'sent'])]</field>
        <field name="context">{'default_southern_quote_type': 'rental', 'default_is_rental_order': True}</field>
    </record>

    <record id="action_southern_rental_orders" model="ir.actions.act_window">
        <field name="name">Rental Orders</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('is_rental_order', '=', True), ('state', 'in', ['sale', 'done'])]</field>
        <field name="context">{'default_southern_quote_type': 'rental', 'default_is_rental_order': True}</field>
    </record>

    <menuitem id="menu_southern_parts_root"
              name="Parts"
              parent="sale.sale_menu_root"
              action="action_southern_parts_all"
              sequence="12"/>
    <menuitem id="menu_southern_parts_new"
              name="New Parts Quotation"
              parent="menu_southern_parts_root"
              action="action_new_parts_quotation"
              sequence="5"/>
    <menuitem id="menu_southern_parts_quotations"
              name="Quotations"
              parent="menu_southern_parts_root"
              action="action_southern_parts_quotations"
              sequence="10"/>
    <menuitem id="menu_southern_parts_orders"
              name="Orders"
              parent="menu_southern_parts_root"
              action="action_southern_parts_orders"
              sequence="20"/>

    <menuitem id="menu_southern_equipment_sales_root"
              name="Equipment Sales"
              parent="sale.sale_menu_root"
              action="action_southern_equipment_sales_all"
              sequence="16"/>
    <menuitem id="menu_southern_equipment_sales_new"
              name="New Equipment Quotation"
              parent="menu_southern_equipment_sales_root"
              action="action_new_equipment_quotation"
              sequence="5"/>
    <menuitem id="menu_southern_equipment_quotations"
              name="Quotations"
              parent="menu_southern_equipment_sales_root"
              action="action_southern_equipment_quotations"
              sequence="10"/>
    <menuitem id="menu_southern_equipment_orders"
              name="Orders"
              parent="menu_southern_equipment_sales_root"
              action="action_southern_equipment_orders"
              sequence="20"/>

    <!-- Move the native Rental application under Sales, like Service. -->
    <record id="sale_renting.rental_menu_root" model="ir.ui.menu">
        <field name="parent_id" ref="sale.sale_menu_root"/>
        <field name="sequence">18</field>
    </record>
    <menuitem id="menu_southern_rental_new"
              name="New Rental Quotation"
              parent="sale_renting.rental_menu_root"
              action="action_new_rental_quotation"
              sequence="1"/>
    <menuitem id="menu_southern_rentals_all"
              name="All Rentals"
              parent="sale_renting.rental_menu_root"
              action="action_southern_rentals_all"
              sequence="2"/>
    <menuitem id="menu_southern_rental_quotations"
              name="Rental Quotations"
              parent="sale_renting.rental_menu_root"
              action="action_southern_rental_quotations"
              sequence="3"/>
    <menuitem id="menu_southern_rental_orders"
              name="Rental Orders"
              parent="sale_renting.rental_menu_root"
              action="action_southern_rental_orders"
              sequence="4"/>
</odoo>
