# Copy this file to odoo_connection.env and fill in the values.
# Do not commit or share odoo_connection.env.

# Sparex dealer website credentials. Keep real values only in odoo_connection.env.
SPAREX_DEALER_LOGIN_URL=https://us.sparex.com/customer/account/
SPAREX_DEALER_PRODUCTS_URL=https://us.sparex.com/
SPAREX_DEALER_USERNAME=
SPAREX_DEALER_PASSWORD=

ODOO_URL=https://your-company.odoo.com
ODOO_DB=your_database_name
ODOO_USERNAME=your_login_email
ODOO_API_KEY=your_odoo_api_key
