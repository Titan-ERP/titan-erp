# Copy to odoo_connection.env and keep the real file outside Git.
ODOO_URL=https://your-company.odoo.com
ODOO_DB=your_database_name
ODOO_API_KEY=

# JSON-2 is the supported Odoo 19 external API and is the default.
ODOO_API_MODE=json2
ODOO_TIMEOUT_SECONDS=90
ODOO_RPC_ATTEMPTS=3

# Required only while an explicitly approved legacy XML-RPC workflow remains.
ODOO_USERNAME=
ODOO_ALLOW_LEGACY_XMLRPC=false
