<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="southern_parts_product_template_form" model="ir.ui.view">
        <field name="name">product.template.form.southern.parts.intelligence</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='list_price']" position="after">
                <field name="southern_partner_price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Parts Intelligence" name="southern_parts_intelligence">
                    <group>
                        <group>
                            <field name="southern_source_name"/>
                            <field name="southern_source_url"/>
                        </group>
                        <group>
                            <field name="southern_enrichment_status"/>
                            <field name="southern_sparex_publication_eligible" readonly="1"/>
                            <field name="southern_parts_search_text" invisible="1"/>
                            <field name="southern_parts_snapshot_refreshed_at" readonly="1"/>
                        </group>
                    </group>
                    <group string="Website Snapshot">
                        <field name="southern_specification_count" readonly="1"/>
                        <field name="southern_fitment_count" readonly="1"/>
                        <field name="southern_fitment_make_count" readonly="1"/>
                        <field name="southern_fitment_model_count" readonly="1"/>
                        <field name="southern_oem_reference_count" readonly="1"/>
                        <field name="southern_catalog_page_count" readonly="1"/>
                        <field name="southern_related_part_count" readonly="1"/>
                        <field name="southern_alternate_barcode_count" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Sparex Sourcing" name="southern_sparex_sourcing">
                            <field name="southern_sparex_sourcing_ids" readonly="1">
                                <list>
                                    <field name="state"/>
                                    <field name="supplier_id"/>
                                    <field name="supplier_price"/>
                                    <field name="currency_id"/>
                                    <field name="approved_retail_price"/>
                                    <field name="attempt_count"/>
                                    <field name="next_attempt_at"/>
                                    <field name="publication_eligible"/>
                                </list>
                            </field>
                        </page>
                        <page string="Specifications" name="southern_specifications">
                            <field name="southern_specification_ids" context="{'default_product_tmpl_id': id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="group_name"/>
                                    <field name="name"/>
                                    <field name="value"/>
                                    <field name="unit"/>
                                    <field name="source_name"/>
                                    <field name="confidence"/>
                                </list>
                            </field>
                        </page>
                        <page string="Fits Make/Model" name="southern_fitments">
                            <field name="southern_fitment_ids" context="{'default_product_tmpl_id': id}">
                                <list editable="bottom">
                                    <field name="make_id"/>
                                    <field name="model_id"/>
                                    <field name="engine"/>
                                    <field name="year_from"/>
                                    <field name="year_to"/>
                                    <field name="build_list"/>
                                    <field name="source_name"/>
                                    <field name="confidence"/>
                                </list>
                            </field>
                        </page>
                        <page string="OEM Part Numbers" name="southern_oem_references">
                            <field name="southern_oem_reference_ids" context="{'default_product_tmpl_id': id}">
                                <list editable="bottom">
                                    <field name="manufacturer"/>
                                    <field name="oem_part_number"/>
                                    <field name="reference_type"/>
                                    <field name="source_name"/>
                                    <field name="confidence"/>
                                </list>
                            </field>
                        </page>
                        <page string="Catalog Pages" name="southern_catalog_pages">
                            <field name="southern_catalog_page_ids" context="{'default_product_tmpl_id': id}">
                                <list editable="bottom">
                                    <field name="catalog_code"/>
                                    <field name="catalog_name"/>
                                    <field name="page_number"/>
                                    <field name="source_name"/>
                                </list>
                            </field>
                        </page>
                        <page string="Related Parts" name="southern_related_parts">
                            <field name="southern_related_part_ids" context="{'default_product_tmpl_id': id}">
                                <list editable="bottom">
                                    <field name="relationship_type"/>
                                    <field name="related_product_tmpl_id"/>
                                    <field name="source_name"/>
                                    <field name="confidence"/>
                                </list>
                            </field>
                        </page>
                        <page string="Alternate Barcodes" name="southern_alternate_barcodes">
                            <field name="southern_alternate_barcode_ids" context="{'default_product_tmpl_id': id}">
                                <list editable="bottom">
                                    <field name="barcode_type"/>
                                    <field name="barcode"/>
                                    <field name="source_name"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </page>
            </xpath>
        </field>
    </record>

    <record id="southern_parts_product_template_search" model="ir.ui.view">
        <field name="name">product.template.search.southern.parts.intelligence</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="southern_parts_search_text" string="Parts Intelligence"/>
                <filter string="Parts Data Complete" name="southern_parts_complete" domain="[('southern_enrichment_status','=','complete')]"/>
                <filter string="Needs Parts Review" name="southern_parts_review" domain="[('southern_enrichment_status','=','review')]"/>
                <separator/>
                <filter string="Parts Data Status" name="group_southern_parts_status" context="{'group_by': 'southern_enrichment_status'}"/>
                <filter string="Source" name="group_southern_source_name" context="{'group_by': 'southern_source_name'}"/>
            </xpath>
        </field>
    </record>

</odoo>
