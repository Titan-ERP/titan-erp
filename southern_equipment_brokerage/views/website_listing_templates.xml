<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="website_equipment_listings" name="Equipment Opportunities">
        <t t-call="website.layout">
            <t t-set="additional_title">Brokered Equipment Opportunities</t>
            <main id="wrap" class="se-brokerage">
                <section class="se-hero py-5">
                    <div class="container py-lg-4">
                        <div class="row align-items-end g-4">
                            <div class="col-lg-8">
                                <span class="se-eyebrow">Southern Equipment sourced deals</span>
                                <h1 class="display-4 fw-bold mt-2">Heavy equipment opportunities, handled by people who know the iron.</h1>
                                <p class="lead mb-0">
                                    We source opportunities, verify seller information and availability,
                                    coordinate inspections, and negotiate the deal from first call through closing.
                                </p>
                            </div>
                            <div class="col-lg-4">
                                <div class="se-trust-card">
                                    <strong>Broker-assisted by default</strong>
                                    <p class="mb-0 mt-2">A listing is not Southern-owned inventory unless it is clearly marked as such.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="container py-5">
                    <form method="get" action="/equipment-opportunities" class="row g-3 align-items-end mb-5 se-filter">
                        <div class="col-md-5">
                            <label for="equipment_type" class="form-label">Equipment type</label>
                            <select id="equipment_type" name="equipment_type" class="form-select">
                                <option value="">All equipment</option>
                                <option t-foreach="equipment_types" t-as="type_row"
                                        t-att-value="type_row[0]"
                                        t-att-selected="equipment_type == type_row[0] and 'selected' or None">
                                    <t t-out="type_row[1]"/>
                                </option>
                            </select>
                        </div>
                        <div class="col-md-5">
                            <label for="region" class="form-label">Region</label>
                            <select id="region" name="region" class="form-select">
                                <option value="">All regions</option>
                                <option t-foreach="regions" t-as="region_name"
                                        t-att-value="region_name"
                                        t-att-selected="region == region_name and 'selected' or None">
                                    <t t-out="region_name"/>
                                </option>
                            </select>
                        </div>
                        <div class="col-md-2 d-grid">
                            <button class="btn btn-dark" type="submit">Find equipment</button>
                        </div>
                    </form>

                    <div t-if="not listings" class="se-empty text-center py-5">
                        <h2>No matching opportunities right now.</h2>
                        <p class="text-muted">Check back soon or contact Southern Equipment with the machine you need.</p>
                    </div>

                    <div class="row g-4">
                        <div t-foreach="listings" t-as="listing" class="col-md-6 col-xl-4">
                            <article class="card se-listing-card h-100 border-0">
                                <div class="se-card-media">
                                    <img t-if="listing.image_1920"
                                         t-att-src="image_data_uri(listing.image_1920)"
                                         t-att-alt="listing.public_title"
                                         class="w-100 h-100 object-fit-cover"/>
                                    <div t-else="" class="se-card-placeholder">
                                        <span><t t-out="listing.manufacturer or 'Southern Equipment'"/></span>
                                    </div>
                                    <span class="se-status"><span t-field="listing.public_status"/></span>
                                    <span t-if="listing.is_southern_owned" class="se-owned">Southern-owned</span>
                                </div>
                                <div class="card-body d-flex flex-column p-4">
                                    <div class="se-spec-line mb-2">
                                        <span t-if="listing.year"><t t-out="listing.year"/></span>
                                        <span t-if="listing.manufacturer"><t t-out="listing.manufacturer"/></span>
                                        <span t-if="listing.model"><t t-out="listing.model"/></span>
                                    </div>
                                    <h2 class="h4"><t t-out="listing.public_title"/></h2>
                                    <div class="d-flex gap-3 text-muted small mb-3">
                                        <span><i class="fa fa-map-marker me-1"/> <t t-out="listing.public_region"/></span>
                                        <span t-if="listing.hours"><i class="fa fa-clock-o me-1"/> <t t-out="'{:,.0f}'.format(listing.hours)"/> hrs</span>
                                    </div>
                                    <p t-if="listing.public_deal_summary" class="se-deal-note">
                                        <t t-out="listing.public_deal_summary"/>
                                    </p>
                                    <div class="mt-auto pt-3">
                                        <div t-if="listing.public_price" class="se-price mb-3">
                                            <span t-field="listing.public_price"
                                                  t-options="{'widget': 'monetary', 'display_currency': listing.currency_id}"/>
                                        </div>
                                        <div t-else="" class="se-price mb-3">Request deal range</div>
                                        <a t-att-href="listing.website_url" class="btn btn-warning w-100">Request this deal</a>
                                    </div>
                                </div>
                            </article>
                        </div>
                    </div>
                    <div class="mt-5"><t t-call="website.pager"/></div>
                </section>
            </main>
        </t>
    </template>

    <template id="website_equipment_listing_detail" name="Equipment Opportunity Detail">
        <t t-call="website.layout">
            <t t-set="additional_title"><t t-out="listing.public_title"/></t>
            <main id="wrap" class="se-brokerage">
                <section class="container py-4 py-lg-5">
                    <a href="/equipment-opportunities" class="se-back-link">
                        <i class="fa fa-arrow-left me-2"/>All equipment opportunities
                    </a>
                    <div class="row g-5 mt-1">
                        <div class="col-lg-7">
                            <div class="se-detail-media">
                                <img t-if="listing.image_1920"
                                     t-att-src="image_data_uri(listing.image_1920)"
                                     t-att-alt="listing.public_title"
                                     class="w-100 h-100 object-fit-cover"/>
                                <div t-else="" class="se-card-placeholder h-100">
                                    <span><t t-out="listing.manufacturer or 'Southern Equipment'"/></span>
                                </div>
                            </div>
                            <div t-if="listing.photo_ids" class="row g-3 mt-1">
                                <div t-foreach="listing.photo_ids.filtered(lambda photo: photo.mimetype and photo.mimetype.startswith('image/'))[:6]"
                                     t-as="photo" class="col-4">
                                    <img t-att-src="image_data_uri(photo.datas)" class="se-thumb w-100 object-fit-cover"
                                         t-att-alt="listing.public_title"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-5">
                            <div class="d-flex flex-wrap gap-2 mb-3">
                                <span class="badge rounded-pill text-bg-warning">
                                    <span t-field="listing.public_status"/>
                                </span>
                                <span t-if="listing.inspection_available" class="badge rounded-pill text-bg-light border">Inspection available</span>
                                <span t-if="listing.is_southern_owned" class="badge rounded-pill text-bg-success">Southern-owned</span>
                                <span t-else="" class="badge rounded-pill text-bg-dark">Broker-assisted sourced deal</span>
                            </div>
                            <h1 class="display-5 fw-bold"><t t-out="listing.public_title"/></h1>
                            <div class="se-detail-price my-4">
                                <span t-if="listing.public_price" t-field="listing.public_price"
                                      t-options="{'widget': 'monetary', 'display_currency': listing.currency_id}"/>
                                <span t-else="">Request deal range</span>
                            </div>
                            <dl class="row se-specs">
                                <dt class="col-5">Region</dt><dd class="col-7"><t t-out="listing.public_region"/></dd>
                                <dt class="col-5">Type</dt><dd class="col-7"><span t-field="listing.equipment_type"/></dd>
                                <dt class="col-5" t-if="listing.manufacturer">Manufacturer</dt><dd class="col-7" t-if="listing.manufacturer"><t t-out="listing.manufacturer"/></dd>
                                <dt class="col-5" t-if="listing.model">Model</dt><dd class="col-7" t-if="listing.model"><t t-out="listing.model"/></dd>
                                <dt class="col-5" t-if="listing.year">Year</dt><dd class="col-7" t-if="listing.year"><t t-out="listing.year"/></dd>
                                <dt class="col-5" t-if="listing.hours">Hours</dt><dd class="col-7" t-if="listing.hours"><t t-out="'{:,.0f}'.format(listing.hours)"/></dd>
                                <dt class="col-5" t-if="listing.show_vin_serial_publicly and listing.vin_serial">VIN / Serial</dt>
                                <dd class="col-7" t-if="listing.show_vin_serial_publicly and listing.vin_serial"><t t-out="listing.vin_serial"/></dd>
                            </dl>
                            <a href="#inquiry" class="btn btn-warning btn-lg w-100 mt-3">Have Southern Equipment negotiate</a>
                        </div>
                    </div>
                </section>

                <section class="se-detail-section py-5">
                    <div class="container">
                        <div class="row g-5">
                            <div class="col-lg-7">
                                <h2>About this opportunity</h2>
                                <div t-if="listing.public_description" t-field="listing.public_description" class="se-description"/>
                                <p t-else="" class="text-muted">Contact us for the curated details on this equipment opportunity.</p>
                            </div>
                            <div class="col-lg-5">
                                <div class="se-verification-box">
                                    <span class="se-eyebrow">Verification</span>
                                    <h3 class="h4 mt-2">Southern Equipment coordinates the legwork.</h3>
                                    <p t-if="listing.verification_note"><t t-out="listing.verification_note"/></p>
                                    <p t-else="">Availability and seller information are verified as the buyer proceeds.</p>
                                    <p t-if="listing.deposit_required" class="small mb-0">
                                        <strong>Deposit note:</strong>
                                        <t t-out="listing.deposit_public_note"/>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <section id="inquiry" class="container py-5">
                    <div class="row justify-content-center">
                        <div class="col-xl-9">
                            <div class="se-inquiry-panel">
                                <div class="row g-5">
                                    <div class="col-lg-5">
                                        <span class="se-eyebrow">Start the conversation</span>
                                        <h2 class="display-6 fw-bold mt-2">Request this deal.</h2>
                                        <p>Tell us what you need. A Southern Equipment broker will contact you to qualify the opportunity and discuss verification, inspection, negotiation, and next steps.</p>
                                    </div>
                                    <div class="col-lg-7">
                                        <div t-if="submitted" class="alert alert-success">
                                            Your request is in. A Southern Equipment broker will follow up.
                                        </div>
                                        <div t-if="error == 'missing'" class="alert alert-danger">Please provide your name, a valid email, and phone number.</div>
                                        <div t-if="error == 'budget'" class="alert alert-danger">Please enter a valid budget.</div>
                                        <form t-att-action="listing.website_url + '/inquire'" method="post">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <div class="d-none" aria-hidden="true">
                                                <label for="website">Website</label><input id="website" name="website" tabindex="-1" autocomplete="off"/>
                                            </div>
                                            <div class="row g-3">
                                                <div class="col-md-6"><label class="form-label" for="name">Name *</label><input id="name" name="name" class="form-control" required="required"/></div>
                                                <div class="col-md-6"><label class="form-label" for="company">Company</label><input id="company" name="company" class="form-control"/></div>
                                                <div class="col-md-6"><label class="form-label" for="email">Email *</label><input id="email" name="email" type="email" class="form-control" required="required"/></div>
                                                <div class="col-md-6"><label class="form-label" for="phone">Phone *</label><input id="phone" name="phone" class="form-control" required="required"/></div>
                                                <div class="col-md-6"><label class="form-label" for="buyer_location">Your location</label><input id="buyer_location" name="buyer_location" class="form-control"/></div>
                                                <div class="col-md-6"><label class="form-label" for="budget">Budget</label><input id="budget" name="budget" type="number" min="0" step="100" class="form-control"/></div>
                                                <div class="col-12">
                                                    <label class="form-label" for="timeline">Purchase timeline</label>
                                                    <select id="timeline" name="timeline" class="form-select">
                                                        <option value="">Choose one</option>
                                                        <option value="immediate">Immediately</option>
                                                        <option value="30_days">Within 30 days</option>
                                                        <option value="90_days">Within 90 days</option>
                                                        <option value="researching">Researching</option>
                                                    </select>
                                                </div>
                                                <div class="col-md-6 form-check ms-2"><input id="financing_needed" name="financing_needed" value="1" type="checkbox" class="form-check-input"/><label for="financing_needed" class="form-check-label">Financing may be needed</label></div>
                                                <div class="col-md-5 form-check ms-2"><input id="trade_in" name="trade_in" value="1" type="checkbox" class="form-check-input"/><label for="trade_in" class="form-check-label">I have a trade-in</label></div>
                                                <div class="col-12"><label class="form-label" for="message">What should we know?</label><textarea id="message" name="message" rows="4" class="form-control"/></div>
                                                <div class="col-12"><button class="btn btn-warning btn-lg w-100" type="submit">Request this deal</button></div>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="container pb-5">
                    <div class="alert se-disclosure mb-0">
                        <strong>Broker-assisted opportunity disclosure:</strong>
                        This is a broker-assisted sourced equipment opportunity
                        <t t-if="listing.is_southern_owned">currently marked as Southern-owned inventory.</t>
                        <t t-else="">and is not represented as Southern Equipment-owned inventory.</t>
                        Southern Equipment verifies availability, coordinates inspection, negotiates terms,
                        and may assign a purchase contract to the buyer after all parties agree.
                        Seller details are withheld during sourcing and verification.
                    </div>
                </section>
            </main>
        </t>
    </template>

    <template id="website_homepage_brokerage_section"
              inherit_id="website.homepage"
              name="Southern Equipment Brokered Opportunities Homepage Section"
              priority="45">
        <xpath expr="//div[@id='wrap']" position="inside">
            <t t-set="brokerage_home_listings"
               t-value="request.env['southern.equipment.listing'].sudo().search([
                    ('website_published', '=', True),
                    ('public_status', 'not in', ['draft', 'archived'])
               ], order='deal_score desc, create_date desc', limit=3)"/>
            <section class="se-home-opportunities py-5" data-snippet="s_text_image" data-name="Brokered Equipment Opportunities">
                <div class="container py-lg-4">
                    <div class="row align-items-end g-3 mb-4">
                        <div class="col-lg-8">
                            <span class="se-eyebrow">Broker-assisted sourced deals</span>
                            <h2 class="display-5 fw-bold mt-2 mb-2">Equipment opportunities worth a closer look.</h2>
                            <p class="lead text-muted mb-0">
                                Southern Equipment verifies availability and seller information,
                                coordinates inspections, and negotiates the deal on your behalf.
                            </p>
                        </div>
                        <div class="col-lg-4 text-lg-end">
                            <a href="/equipment-opportunities" class="btn btn-dark btn-lg">
                                View all opportunities <i class="fa fa-arrow-right ms-2"/>
                            </a>
                        </div>
                    </div>

                    <div t-if="brokerage_home_listings" class="row g-4">
                        <div t-foreach="brokerage_home_listings" t-as="listing" class="col-md-4">
                            <article class="card se-home-opportunity-card h-100 border-0">
                                <a t-att-href="'/equipment-opportunities/' + listing.public_slug"
                                   class="se-home-card-media text-decoration-none">
                                    <img t-if="listing.image_1920"
                                         t-att-src="image_data_uri(listing.image_1920)"
                                         t-att-alt="listing.public_title"
                                         class="w-100 h-100 object-fit-cover"/>
                                    <div t-else="" class="se-card-placeholder">
                                        <span><t t-out="listing.manufacturer or 'Southern Equipment'"/></span>
                                    </div>
                                    <span class="se-status"><span t-field="listing.public_status"/></span>
                                </a>
                                <div class="card-body p-4">
                                    <div class="se-spec-line mb-2">
                                        <span t-if="listing.year"><t t-out="listing.year"/></span>
                                        <span t-if="listing.manufacturer"><t t-out="listing.manufacturer"/></span>
                                        <span t-if="listing.model"><t t-out="listing.model"/></span>
                                    </div>
                                    <h3 class="h5">
                                        <a t-att-href="'/equipment-opportunities/' + listing.public_slug"
                                           class="stretched-link text-reset text-decoration-none">
                                            <t t-out="listing.public_title"/>
                                        </a>
                                    </h3>
                                    <div class="d-flex justify-content-between align-items-end gap-3 mt-3">
                                        <span class="text-muted small">
                                            <i class="fa fa-map-marker me-1"/>
                                            <t t-out="listing.public_region"/>
                                        </span>
                                        <strong class="se-home-price" t-if="listing.public_price">
                                            <span t-field="listing.public_price"
                                                  t-options="{'widget': 'monetary', 'display_currency': listing.currency_id}"/>
                                        </strong>
                                        <strong class="se-home-price" t-else="">Request range</strong>
                                    </div>
                                </div>
                            </article>
                        </div>
                    </div>

                    <div t-else="" class="se-home-opportunity-empty">
                        <div>
                            <h3 class="h4 mb-1">Looking for a specific machine?</h3>
                            <p class="text-muted mb-0">Tell Southern Equipment what you need and we’ll help source the opportunity.</p>
                        </div>
                        <a href="/contactus" class="btn btn-warning">Start a search</a>
                    </div>

                    <p class="se-home-disclosure mt-4 mb-0">
                        Listings are broker-assisted sourced equipment opportunities unless clearly marked
                        Southern-owned. Seller identity and original source details remain confidential during
                        sourcing and verification.
                    </p>
                </div>
            </section>
        </xpath>
    </template>

    <record id="website_menu_equipment_opportunities" model="website.menu">
        <field name="name">Equipment Opportunities</field>
        <field name="url">/equipment-opportunities</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence">35</field>
    </record>
</odoo>
