<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_southern_equipment_model_alias_list" model="ir.ui.view">
        <field name="name">southern.equipment.model.alias.list</field>
        <field name="model">southern.equipment.model.alias</field>
        <field name="arch" type="xml">
            <list>
                <field name="active"/>
                <field name="equipment_type"/>
                <field name="manufacturer"/>
                <field name="alias"/>
                <field name="canonical_model"/>
                <field name="source_note"/>
                <field name="source_url" widget="url" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_southern_equipment_model_alias_form" model="ir.ui.view">
        <field name="name">southern.equipment.model.alias.form</field>
        <field name="model">southern.equipment.model.alias</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Reviewed Mapping">
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="equipment_type"/>
                            <field name="manufacturer"/>
                            <field name="alias"/>
                            <field name="canonical_model"/>
                        </group>
                        <group string="Evidence">
                            <field name="source_note"/>
                            <field name="source_url" widget="url"/>
                            <field name="notes"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_southern_equipment_model_aliases" model="ir.actions.act_window">
        <field name="name">Reviewed Model Aliases</field>
        <field name="res_model">southern.equipment.model.alias</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a reviewed model-name equivalence</p>
            <p>Only source-supported aliases should map to a canonical model. Formatting normalization remains automatic.</p>
        </field>
    </record>
</odoo>
