<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_southern_inspection_order_list" model="ir.ui.view">
        <field name="name">southern.inspection.order.list</field>
        <field name="model">southern.inspection.order</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="listing_id"/>
                <field name="deal_id"/>
                <field name="inspection_vendor_id"/>
                <field name="scheduled_datetime"/>
                <field name="inspection_fee"/>
                <field name="status"/>
                <field name="pass_fail"/>
            </list>
        </field>
    </record>
    <record id="view_southern_inspection_order_form" model="ir.ui.view">
        <field name="name">southern.inspection.order.form</field>
        <field name="model">southern.inspection.order</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_mark_ordered" string="Mark Ordered" type="object" class="btn-primary" invisible="status != 'draft'"/>
                    <button name="action_mark_complete" string="Complete Inspection" type="object" class="btn-primary" invisible="status not in ['ordered', 'scheduled']"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,ordered,scheduled,complete"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="deal_id"/>
                            <field name="listing_id"/>
                            <field name="inspection_vendor_id"/>
                            <field name="scheduled_datetime"/>
                            <field name="inspection_location"/>
                        </group>
                        <group>
                            <field name="inspection_fee"/>
                            <field name="deposit_amount_allocated" groups="southern_equipment_brokerage.group_southern_equipment_admin"/>
                            <field name="pass_fail"/>
                            <field name="repair_estimate"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Report">
                            <field name="report_file" filename="report_filename"/>
                            <field name="report_filename" invisible="1"/>
                            <field name="summary" widget="html"/>
                        </page>
                        <page string="Photos"><field name="photo_ids" widget="many2many_binary"/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_southern_inspection_orders" model="ir.actions.act_window">
        <field name="name">Inspection Orders</field>
        <field name="res_model">southern.inspection.order</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_southern_contract_assignment_list" model="ir.ui.view">
        <field name="name">southern.contract.assignment.list</field>
        <field name="model">southern.contract.assignment</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="deal_id"/>
                <field name="listing_id"/>
                <field name="buyer_id"/>
                <field name="seller_id"/>
                <field name="purchase_contract_status"/>
                <field name="assignment_status"/>
                <field name="effective_datetime"/>
            </list>
        </field>
    </record>
    <record id="view_southern_contract_assignment_form" model="ir.ui.view">
        <field name="name">southern.contract.assignment.form</field>
        <field name="model">southern.contract.assignment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_execute" string="Execute Assignment" type="object" class="btn-primary"
                            invisible="assignment_status == 'executed'"/>
                    <field name="assignment_status" widget="statusbar"
                           statusbar_visible="draft,sent,buyer_signed,seller_consent_required,seller_consented,executed"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="deal_id"/>
                            <field name="listing_id"/>
                            <field name="buyer_id"/>
                            <field name="seller_id"/>
                        </group>
                        <group>
                            <field name="seller_consent_required"/>
                            <field name="seller_consent_received" invisible="not seller_consent_required"/>
                            <field name="buyer_approval_received"/>
                            <field name="southern_approval_received"/>
                            <field name="effective_datetime" readonly="1"/>
                            <field name="assignment_fee" groups="southern_equipment_brokerage.group_southern_equipment_admin"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Purchase Contract">
                            <group><field name="purchase_contract_status"/></group>
                            <field name="purchase_contract_file" filename="purchase_contract_filename"/>
                            <field name="purchase_contract_filename" invisible="1"/>
                        </page>
                        <page string="Assignment Agreement">
                            <field name="assignment_agreement_file" filename="assignment_agreement_filename"/>
                            <field name="assignment_agreement_filename" invisible="1"/>
                        </page>
                        <page string="Notes"><field name="notes" widget="html"/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_southern_contract_assignments" model="ir.actions.act_window">
        <field name="name">Contract Assignments</field>
        <field name="res_model">southern.contract.assignment</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_southern_deposit_ledger_list" model="ir.ui.view">
        <field name="name">southern.deposit.ledger.list</field>
        <field name="model">southern.deposit.ledger</field>
        <field name="arch" type="xml">
            <list decoration-muted="status == 'void'" decoration-success="status == 'posted'">
                <field name="transaction_date"/>
                <field name="deal_id"/>
                <field name="buyer_id"/>
                <field name="transaction_type"/>
                <field name="amount"/>
                <field name="held_by"/>
                <field name="payment_reference"/>
                <field name="status"/>
            </list>
        </field>
    </record>
    <record id="view_southern_deposit_ledger_form" model="ir.ui.view">
        <field name="name">southern.deposit.ledger.form</field>
        <field name="model">southern.deposit.ledger</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_post" string="Post" type="object" class="btn-primary" invisible="status != 'draft'"/>
                    <button name="action_void" string="Void" type="object" invisible="status == 'void'"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="deal_id"/>
                            <field name="buyer_id" readonly="1"/>
                            <field name="transaction_date"/>
                            <field name="transaction_type"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="held_by"/>
                            <field name="payment_reference"/>
                        </group>
                    </group>
                    <field name="notes"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_southern_deposit_ledger" model="ir.actions.act_window">
        <field name="name">Deposit Ledger</field>
        <field name="res_model">southern.deposit.ledger</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
