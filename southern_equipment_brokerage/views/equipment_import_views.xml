<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_southern_equipment_import_wizard_form" model="ir.ui.view">
        <field name="name">southern.equipment.import.wizard.form</field>
        <field name="model">southern.equipment.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Equipment Opportunities">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Upload an authorized <strong>odoo-equipment-opportunities.csv</strong>
                        from the local lead agent, a dealer, an auction, a referral, or an official export.
                        Imported listings remain unpublished and retain exact seller location, contact data,
                        source URL, serial, and captured notes in restricted internal fields.
                    </div>
                    <group>
                        <field name="upload_file" filename="upload_filename"/>
                        <field name="upload_filename" invisible="1"/>
                        <field name="update_existing"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_import" string="Import Opportunities" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_southern_equipment_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Equipment Opportunity CSV</field>
        <field name="res_model">southern.equipment.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
