<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_southern_equipment_spec_profile_list" model="ir.ui.view">
        <field name="name">southern.equipment.spec.profile.list</field>
        <field name="model">southern.equipment.spec.profile</field>
        <field name="arch" type="xml">
            <list>
                <field name="active"/>
                <field name="equipment_type"/>
                <field name="manufacturer"/>
                <field name="model"/>
                <field name="operating_weight_lb"/>
                <field name="horsepower"/>
                <field name="rated_capacity_lb"/>
                <field name="lift_height_ft"/>
                <field name="undercarriage"/>
                <field name="configuration"/>
                <field name="source_note"/>
            </list>
        </field>
    </record>

    <record id="view_southern_equipment_spec_profile_form" model="ir.ui.view">
        <field name="name">southern.equipment.spec.profile.form</field>
        <field name="model">southern.equipment.spec.profile</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group string="Identity">
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="equipment_type"/>
                            <field name="manufacturer"/>
                            <field name="model"/>
                            <field name="configuration"/>
                            <field name="undercarriage"/>
                        </group>
                        <group string="Comparable-Matching Specifications">
                            <field name="operating_weight_lb"/>
                            <field name="horsepower"/>
                            <field name="rated_capacity_lb"/>
                            <field name="lift_height_ft"/>
                        </group>
                    </group>
                    <group string="Evidence">
                        <field name="source_note"/>
                        <field name="source_url" widget="url"/>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_southern_equipment_spec_profiles" model="ir.actions.act_window">
        <field name="name">Specification Catalog</field>
        <field name="res_model">southern.equipment.spec.profile</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Document a machine specification profile</p>
            <p>Cross-brand comps are permitted only when documented physical specifications establish a same-size peer.</p>
        </field>
    </record>
</odoo>
