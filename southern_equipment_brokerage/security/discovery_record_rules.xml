<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_southern_equipment_discovery_candidate_company" model="ir.rule">
        <field name="name">Equipment discovery candidates allowed companies</field>
        <field name="model_id" ref="model_southern_equipment_discovery_candidate"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
    <record id="rule_southern_equipment_discovery_evidence_company" model="ir.rule">
        <field name="name">Equipment discovery evidence allowed companies</field>
        <field name="model_id" ref="model_southern_equipment_discovery_evidence"/>
        <field name="domain_force">[('candidate_id.company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
</odoo>
