<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_southern_brokerage" model="ir.module.category">
        <field name="name">Southern Equipment Brokerage</field>
        <field name="description">Access to sourced equipment opportunities and brokered deals.</field>
        <field name="sequence">35</field>
    </record>

    <record id="privilege_southern_brokerage" model="res.groups.privilege">
        <field name="name">Equipment Brokerage Access</field>
        <field name="category_id" ref="module_category_southern_brokerage"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_southern_inspector_coordinator" model="res.groups">
        <field name="name">Inspector Coordinator</field>
        <field name="privilege_id" ref="privilege_southern_brokerage"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_southern_deal_broker" model="res.groups">
        <field name="name">Deal Broker</field>
        <field name="privilege_id" ref="privilege_southern_brokerage"/>
        <field name="sequence">20</field>
    </record>

    <record id="group_southern_equipment_admin" model="res.groups">
        <field name="name">Southern Equipment Admin</field>
        <field name="privilege_id" ref="privilege_southern_brokerage"/>
        <field name="sequence">30</field>
        <field name="implied_ids" eval="[(4, ref('group_southern_deal_broker')), (4, ref('group_southern_inspector_coordinator'))]"/>
    </record>
</odoo>
