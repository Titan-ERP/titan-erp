<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stripe_terminal_payment_list" model="ir.ui.view">
        <field name="name">southern.stripe.terminal.payment.list</field>
        <field name="model">southern.stripe.terminal.payment</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'registered'" decoration-warning="state in ('in_progress', 'stripe_succeeded')" decoration-danger="state in ('failed', 'needs_review')">
                <field name="invoice_id"/>
                <field name="partner_id"/>
                <field name="config_id"/>
                <field name="invoice_amount" optional="show"/>
                <field name="processing_fee_amount" optional="show"/>
                <field name="amount"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state"/>
                <field name="stripe_status" optional="show"/>
                <field name="account_payment_id" optional="show"/>
                <field name="started_at" optional="show"/>
                <field name="completed_at" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_stripe_terminal_payment_form" model="ir.ui.view">
        <field name="name">southern.stripe.terminal.payment.form</field>
        <field name="model">southern.stripe.terminal.payment</field>
        <field name="arch" type="xml">
            <form string="Stripe Terminal Payment" create="0" delete="0">
                <header>
                    <button name="action_refresh_status" string="Refresh Status" type="object" class="oe_highlight" invisible="state not in ('in_progress', 'stripe_succeeded', 'needs_review')"/>
                    <button name="action_simulate_card" string="Simulate Card" type="object" class="btn-secondary" invisible="provider_state != 'test' or state != 'in_progress'"/>
                    <button name="action_retry" string="Retry on Reader" type="object" class="oe_highlight" invisible="state != 'failed'"/>
                    <button name="action_cancel" string="Cancel" type="object" confirm="Cancel the reader action and PaymentIntent?" invisible="state not in ('draft', 'in_progress', 'failed')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,stripe_succeeded,registered,needs_review"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="invoice_id"/></h1></div>
                    <group>
                        <group string="Payment">
                            <field name="partner_id" readonly="1"/>
                            <field name="invoice_amount" readonly="1"/>
                            <field name="processing_fee_amount" readonly="1"/>
                            <field name="processing_fee_embedded" readonly="1"/>
                            <field name="amount" readonly="1"/>
                            <field name="currency_id" readonly="1"/>
                            <field name="config_id" readonly="1"/>
                            <field name="provider_state" readonly="1"/>
                            <field name="account_payment_id" readonly="1"/>
                            <field name="fee_invoice_id" readonly="1"/>
                        </group>
                        <group string="Stripe Status">
                            <field name="payment_intent_id" readonly="1"/>
                            <field name="stripe_status" readonly="1"/>
                            <field name="reader_action_status" readonly="1"/>
                            <field name="stripe_failure_code" readonly="1"/>
                            <field name="stripe_failure_message" readonly="1"/>
                            <field name="started_at" readonly="1"/>
                            <field name="completed_at" readonly="1"/>
                            <field name="retry_count" readonly="1"/>
                        </group>
                    </group>
                    <notebook><page string="Audit Trail"><field name="message_ids" widget="mail_thread"/></page></notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_stripe_terminal_payment_search" model="ir.ui.view">
        <field name="name">southern.stripe.terminal.payment.search</field>
        <field name="model">southern.stripe.terminal.payment</field>
        <field name="arch" type="xml">
            <search>
                <field name="invoice_id"/>
                <field name="partner_id"/>
                <field name="payment_intent_id"/>
                <filter name="active_payments" string="Active" domain="[('state', 'in', ('draft', 'in_progress', 'stripe_succeeded'))]"/>
                <filter name="needs_review" string="Needs Review" domain="[('state', '=', 'needs_review')]"/>
                <filter name="registered" string="Registered" domain="[('state', '=', 'registered')]"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_reader" string="Reader" context="{'group_by': 'config_id'}"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
            </search>
        </field>
    </record>

    <record id="action_stripe_terminal_payment" model="ir.actions.act_window">
        <field name="name">Stripe Terminal Payments</field>
        <field name="res_model">southern.stripe.terminal.payment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_stripe_terminal_payment_search"/>
    </record>
</odoo>
