<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_stripe_terminal" model="ir.ui.view">
        <field name="name">account.move.form.stripe.terminal</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_pay_with_stripe_terminal"
                        string="Pay with Stripe Terminal"
                        type="object"
                        class="oe_highlight"
                        groups="account.group_account_invoice"
                        invisible="move_type != 'out_invoice' or state != 'posted' or payment_state in ('paid', 'reversed') or amount_residual &lt;= 0"/>
            </xpath>
        </field>
    </record>
</odoo>
