<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_southern_payments" model="ir.module.category">
        <field name="name">Southern Payments</field>
        <field name="description">Controlled access to Southern Equipment payment collection methods.</field>
        <field name="sequence">32</field>
    </record>

    <record id="privilege_southern_payments" model="res.groups.privilege">
        <field name="name">Payment Collection Access</field>
        <field name="category_id" ref="module_category_southern_payments"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_stripe_terminal_moto" model="res.groups">
        <field name="name">Stripe Pay by Phone</field>
        <field name="privilege_id" ref="privilege_southern_payments"/>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>

</odoo>
