<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crm_lead_form_parcel_links" model="ir.ui.view">
        <field name="name">crm.lead.form.parcel.links</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_parcel_links" type="object" class="oe_stat_button" icon="fa-map-marker">
                    <field name="parcel_match_count" widget="statinfo" string="Parcel Matches"/>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Parcel Links" name="loki_parcel_links">
                    <group>
                        <field name="primary_parcel_link_id" options="{'no_create': True}"/>
                    </group>
                    <field name="parcel_link_ids" context="{'default_company_id': company_id, 'default_partner_id': partner_id}">
                        <list editable="bottom">
                            <field name="company_id" column_invisible="True"/>
                            <field name="partner_id" column_invisible="True"/>
                            <field name="source_key"/>
                            <field name="parcel_account"/>
                            <field name="county" optional="show"/>
                            <field name="state_code" optional="show"/>
                            <field name="match_method"/>
                            <field name="confidence" widget="percentage"/>
                            <field name="review_state" widget="badge"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
