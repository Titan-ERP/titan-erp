<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_loki_crm_parcel_link_list" model="ir.ui.view">
        <field name="name">loki.crm.parcel.link.list</field>
        <field name="model">loki.crm.parcel.link</field>
        <field name="arch" type="xml">
            <list decoration-success="review_state == 'matched'" decoration-warning="review_state == 'review'" decoration-muted="review_state in ('unmatched', 'rejected')">
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="crm_lead_id"/>
                <field name="partner_id" optional="show"/>
                <field name="source_key"/>
                <field name="parcel_account"/>
                <field name="county" optional="show"/>
                <field name="state_code" optional="show"/>
                <field name="match_method"/>
                <field name="confidence" widget="percentage"/>
                <field name="review_state" widget="badge"/>
                <field name="matched_at" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_loki_crm_parcel_link_form" model="ir.ui.view">
        <field name="name">loki.crm.parcel.link.form</field>
        <field name="model">loki.crm.parcel.link</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_source" type="object" string="Open Parcel Source" class="btn-primary" invisible="not source_url"/>
                    <field name="review_state" widget="statusbar" statusbar_visible="unmatched,review,matched,rejected"/>
                </header>
                <sheet>
                    <group>
                        <group string="CRM Record">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="crm_lead_id"/>
                            <field name="partner_id"/>
                        </group>
                        <group string="Parcel Identity">
                            <field name="source_key"/>
                            <field name="parcel_account"/>
                            <field name="parcel_external_id"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <group string="Match">
                        <group>
                            <field name="match_method"/>
                            <field name="confidence" widget="percentage"/>
                            <field name="matched_at"/>
                        </group>
                        <group>
                            <field name="county"/>
                            <field name="state_code"/>
                            <field name="latitude"/>
                            <field name="longitude"/>
                        </group>
                    </group>
                    <group string="Evidence">
                        <field name="source_url" widget="url"/>
                        <field name="evidence_json"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_loki_crm_parcel_link_search" model="ir.ui.view">
        <field name="name">loki.crm.parcel.link.search</field>
        <field name="model">loki.crm.parcel.link</field>
        <field name="arch" type="xml">
            <search>
                <field name="crm_lead_id"/>
                <field name="partner_id"/>
                <field name="parcel_account"/>
                <field name="parcel_external_id"/>
                <field name="source_key"/>
                <field name="county"/>
                <filter name="matched" string="Matched" domain="[('review_state', '=', 'matched')]"/>
                <filter name="needs_review" string="Needs Review" domain="[('review_state', '=', 'review')]"/>
                <filter name="unmatched" string="Unmatched" domain="[('review_state', '=', 'unmatched')]"/>
                <separator/>
                <filter name="group_review_state" string="Review State" context="{'group_by': 'review_state'}"/>
                <filter name="group_source" string="Source" context="{'group_by': 'source_key'}"/>
                <filter name="group_county" string="County" context="{'group_by': 'county'}"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
            </search>
        </field>
    </record>

    <record id="action_loki_crm_parcel_links" model="ir.actions.act_window">
        <field name="name">Parcel Links</field>
        <field name="res_model">loki.crm.parcel.link</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_loki_crm_parcel_link_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Link a CRM record to a parcel.</p>
            <p>Store the parcel identity and matching evidence here; keep full geometry in LOKI.</p>
        </field>
    </record>
</odoo>
